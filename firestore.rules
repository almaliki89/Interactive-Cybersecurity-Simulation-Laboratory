rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'language']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.language in ['ar', 'en'] &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.email == null || (data.email is string && data.email.size() <= 256));
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['uid']) &&
             data.keys().hasOnly(['uid', 'completedLessons', 'completedChallenges', 'lessonProgress', 'onboardingProgress', 'activeLessonId', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.completedLessons is list &&
             data.completedChallenges is list &&
             data.lessonProgress is map &&
             data.onboardingProgress is map;
    }

    function isValidTelemetry(data) {
      return data.keys().hasAll(['uid', 'simulationId', 'action', 'timestamp']) &&
             data.uid == request.auth.uid &&
             data.simulationId is string && data.simulationId.size() <= 128 &&
             data.action is string && data.action.size() <= 128 &&
             data.timestamp == request.time;
    }

    // --- Match Blocks ---

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isVerified() && isValidUserProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(uid) && isVerified() && isValidUserProfile(incoming()) && 
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
      
      match /progress/current {
        allow get: if isOwner(uid);
        allow create: if isOwner(uid) && isVerified() && isValidUserProgress(incoming());
        allow update: if isOwner(uid) && isVerified() && isValidUserProgress(incoming()) &&
                         incoming().uid == existing().uid &&
                         incoming().updatedAt == request.time;
      }
    }

    match /telemetry/{logId} {
      allow create: if isVerified() && isValidTelemetry(incoming());
      allow read: if false; // Only accessible via GCP console or restricted admin views
    }
  }
}
