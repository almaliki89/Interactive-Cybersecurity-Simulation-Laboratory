rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: every collection must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'language', 'createdAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == request.auth.uid &&
        data.language in ['ar', 'en'] &&
        data.createdAt is timestamp &&
        (!('displayName' in data) ||
          data.displayName == null ||
          (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('email' in data) ||
          (data.email is string &&
            data.email == request.auth.token.email &&
            data.email.size() <= 256)) &&
        (!('updatedAt' in data) ||
          (data.updatedAt is timestamp && data.updatedAt == request.time));
    }

    function isValidTelemetry(data) {
      return data.keys().hasAll(['uid', 'simulationId', 'action', 'timestamp']) &&
        data.keys().hasOnly([
          'uid', 'simulationId', 'action', 'details', 'timestamp'
        ]) &&
        data.uid == request.auth.uid &&
        data.simulationId is string &&
        data.simulationId.size() > 0 &&
        data.simulationId.size() <= 128 &&
        data.action is string &&
        data.action.size() > 0 &&
        data.action.size() <= 128 &&
        (!('details' in data) ||
          (data.details is map && data.details.size() <= 20)) &&
        data.timestamp == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);

      allow create: if isOwner(uid) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid) &&
        isValidUserProfile(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
    }

    match /users/{uid}/progress/current {
      // Progress is readable only by its verified owner.
      allow get: if isOwner(uid);

      // Browser-generated completions are not authoritative attestations.
      // Only a trusted server using the Admin SDK may create or modify this document.
      allow create, update, delete: if false;
    }

    match /telemetry/{logId} {
      // Append-only, bounded telemetry from verified users.
      allow create: if isVerified() && isValidTelemetry(request.resource.data);
      allow get, list, update, delete: if false;
    }
  }
}
